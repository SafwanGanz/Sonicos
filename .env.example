# Database configuration ("sqlite3" or "pgx")
# Tip: On Railway/Heroku without a volume, set DATABASE_URL to a Supabase/Neon
# PostgreSQL URL (postgres://...). Sonicos auto-detects pgx + Supabase poolers
# and persists BOTH WhatsApp sessions and all bot features with zero volumes or Redis.
DATABASE_DRIVER=sqlite3
DATABASE_URL=file:./data/sonicos.db?_foreign_keys=on&_journal_mode=WAL&_busy_timeout=5000

# Redis connection URL (default used locally; optional on Railway/Heroku, which
# automatically falls back to SQLite/PostgreSQL feature storage if Redis is omitted)
REDIS_URL=redis://localhost:6379/0

# Bot command prefix
BOT_PREFIX=!

# Worker pool settings
WORKERS=8
QUEUE_SIZE=512

# Web onboarding & dashboard password (alphanumeric or numeric).
# Leave empty on local PC/VPS to keep the web dashboard disabled (terminal QR only).
# Set a strong password on Railway/Heroku to enable the protected web dashboard.
DASHBOARD_PASSWORD=
BOT_OWNER=917306771605
# HTTP port for the web dashboard (default 8080; set automatically by Railway/Heroku)
# PORT=8080

# Optional comma-separated list of extra allowed CORS origins (same-origin is always allowed)
# CORS_ALLOWED_ORIGINS=
# Logging level ("debug", "info", "warn", "error")
LOG_LEVEL=info

# Optional path to ffmpeg binary (defaults to "ffmpeg" in PATH)
FFMPEG_PATH=ffmpeg

# AI Driven mode (owner-controlled, OFF by default on fresh installs)
# Authorized bot owner(s): a single number in BOT_OWNER, or a comma-separated
# list in BOT_OWNER_JIDS (both are merged). Accepts bare phone numbers or full
# WhatsApp JIDs. Without this, nobody can run owner-only commands.
BOT_OWNER=
BOT_OWNER_JIDS=
# OpenAI-compatible AI backend. AI Driven mode cannot be enabled without a key.
# AI_BASE_URL defaults to https://api.openai.com/v1 (works with OpenAI,
# Groq, OpenRouter, Ollama-compatible servers, etc.)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_STT_MODEL=whisper-1

# Local gemini-web2api server (https://github.com/Sophomoresty/gemini-web2api)
# OpenAI-compatible text backend. The server is STATELESS: Sonicos sends the
# conversation history with every request. Audio input is NOT supported by
# this server; voice transcription uses GEMINI_API_KEY below.
# GEMINI_WEB2API_ENABLED=true
# GEMINI_WEB2API_BASE_URL=http://127.0.0.1:8081/v1
# GEMINI_WEB2API_API_KEY=            # empty when the server runs without api_keys
# GEMINI_WEB2API_MODEL=              # preferred model; validated via GET /v1/models
# GEMINI_WEB2API_FALLBACK_MODEL=gemini-3.5-flash
# GEMINI_WEB2API_TIMEOUT=180s
# GEMINI_WEB2API_MAX_RETRIES=2
# Note: 127.0.0.1 only works when Sonicos runs on the same machine (or host
# networking in Docker). On remote deployments use a reachable address and
# keep the server behind authentication; never expose it publicly casually.

# Free-tier Google Gemini API key (AI Studio) for voice-note transcription.
# The native Gemini API accepts inline OGG/Opus audio, so WhatsApp voice
# notes work without conversion. This route is independent of Web2API.
# GEMINI_API_KEY=
# GEMINI_STT_MODEL=gemini-2.5-flash
# GEMINI_STT_FALLBACK_MODEL=gemini-flash-lite

# Voice-note replies for AI mode (requires the edge-tts CLI)
# EDGE_TTS_VOICE=en-US-AriaNeural
